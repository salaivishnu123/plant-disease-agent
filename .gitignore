# Python
__pycache__/
*.pyc
venv/
.venv/

# Model artifacts: the TRAINED MODEL and class mapping ARE committed on
# purpose (23.8MB, well under GitHub's 100MB limit) — this is a portfolio
# repo, so anyone cloning it can run the app immediately without waiting
# ~9 hours to retrain. Only exclude the plot/report files, which are easy
# to regenerate and not needed to run the app.
models/*.png
models/classification_report.txt

# Dataset: raw and split image folders are NOT committed (too large, and
# not needed to run the app — only needed to retrain). See README.md for
# how to regenerate these via download_and_prepare_dataset.py + split_dataset.py.
dataset/train/*
dataset/val/*
dataset/test/*
!dataset/train/.gitkeep
!dataset/val/.gitkeep
!dataset/test/.gitkeep
raw_data/
kaggle_downloads/

# OS/editor
.DS_Store
.vscode/